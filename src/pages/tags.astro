---
import BaseLayout from '../layouts/BaseLayout.astro';import {getCardPosts} from '../lib/content';import {tagSlug} from '../lib/public-content';
const posts=await getCardPosts();const tags=[...new Set(posts.flatMap(p=>p.tags))].sort((a,b)=>a.localeCompare(b,'hu'));
---
<BaseLayout title="Címkék" description="Fedezd fel a történetek közötti kapcsolatokat."><div class="container"><section class="page-heading"><div><p class="eyebrow">APRÓ KAPCSOLATOK</p><h1>Címkék</h1><p>Ugyanaz a gondolat, egy másik történetben.</p></div></section><div class="inline-stack">{tags.map(tag=><a class="btn" href={`/tag/${tagSlug(tag)}/`}>#{tag}<span class="muted">{posts.filter(p=>p.tags.includes(tag)).length}</span></a>)}</div></div></BaseLayout>
