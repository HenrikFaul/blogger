---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro';import {getCollection} from 'astro:content';import {getCardPosts} from '../../lib/content';
export async function getStaticPaths(){const authors=await getCollection('authors');const posts=await getCardPosts();return authors.map(author=>({params:{slug:author.id},props:{author,posts:posts.filter(p=>p.authorId===author.id)}}));}
const {author,posts}=Astro.props;
---
<ArchiveLayout title={author.data.name} description={author.data.bio||'A szerző történetei.'} eyebrow="A MAGAZIN SZERZŐI" posts={posts} type="person" person={{name:author.data.name,bio:author.data.bio}}/>
