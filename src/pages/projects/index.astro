---
import BaseLayout from '../../layouts/BaseLayout.astro';import Icon from '../../components/ui/Icon.astro';import {getCollection} from 'astro:content';import {isPublic,getSlug} from '../../lib/public-content';
const projects=(await getCollection('projects')).filter(p=>isPublic(p.data));
---
<BaseLayout title="Projektek és kísérletek" description="Gondolatból terv, tervből történet. A magazin projektgyűjteménye."><div class="container"><section class="page-heading"><div><p class="eyebrow">AMIN DOLGOZUNK</p><h1>Projektek és kísérletek.</h1><p>Egy ötlet útja az első kérdéstől a következő lépésig.</p></div></section><div class="taxonomy-grid">{projects.map(p=><article class="taxonomy-card">{p.data.heroImage&&<img src={p.data.heroImage.src} alt={p.data.heroImage.alt} width={p.data.heroImage.width||600} height={p.data.heroImage.height||400} loading="lazy"/>}<div class="taxonomy-card-content"><p class="eyebrow" style="margin-bottom:12px">{p.data.year} · {p.data.role}</p><h2><a href={`/projects/${getSlug(p)}/`}>{p.data.title}</a></h2><p>{p.data.excerpt}</p><a class="text-link" href={`/projects/${getSlug(p)}/`}>A projekt története<Icon name="arrow" size={15}/></a></div></article>)}</div></div></BaseLayout>
