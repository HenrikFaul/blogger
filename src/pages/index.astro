---
/**
 * ForgeBlog UI rebuilt to match the design reference.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/content/PostCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getCardPosts } from '../lib/content';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';
import NewsletterSignup from '../components/content/NewsletterSignup.astro';

const posts = await getCardPosts();
const home = siteConfig.home;
const latest = posts.slice(0, 4);
const blogPosts = posts.slice(0, 20).map((p) => ({
  headline: p.title,
  url: new URL(`/posts/${p.slug}/`, siteConfig.siteUrl).href,
  datePublished: p.date,
}));

const categories = await getCollection('categories');

// Map icons to categories
const catIcons: Record<string, string> = {
  'technologia': 'settings',
  'tech': 'settings',
  'utazas': 'arrow-up',
  'gasztronomia': 'home',
  'eletmod': 'palette',
  'fotografia': 'image',
  'alkotas': 'palette'
};
---
<BaseLayout title={siteConfig.name} description={home.lede} type="blog" blogPosts={blogPosts}>
  <div class="container forge-home">

    <!-- 1. HERO SECTION -->
    <section class="forge-hero">
      <div class="forge-hero-content">
        <p class="eyebrow"><span class="dot"></span>{home.eyebrow}</p>
        <h1 class="headline">{home.headline}<br/><strong>{home.headlineAccent}</strong></h1>
        <p class="lede">{home.lede}</p>
        <div class="actions">
          <a class="btn btn-primary" href={home.primaryCtaHref}>{home.primaryCtaLabel} <Icon name="arrow" size={16}/></a>
          <a class="btn btn-secondary" href={home.secondaryCtaHref}>{home.secondaryCtaLabel}</a>
        </div>
        <ul class="assurances">
          {home.assurances.map(a => <li><Icon name="check" size={14}/> {a}</li>)}
        </ul>
      </div>

      <div class="forge-hero-visuals">
        <div class="masonry-grid">
          <div class="masonry-main">
            <div class="hero-card hero-card-large">
              <span class="badge">FEATURED</span>
              <img src="/media/catalog/library-hero.jpg" alt="A kinder internet" class="hero-img" />
              <div class="card-content">
                <h3>Egy emberségesebb internet</h3>
                <p>Gondolatok a lassabb alkotásról, a letisztultabb gondolkodásról és egy emberségesebb webről.</p>
                <div class="meta">
                  <img src="/media/nora.svg" class="avatar" alt="Author" />
                  <span>By Nóra Szabó · Ápr 12, 2026</span>
                  <div class="arrow-circle"><Icon name="arrow" size={14}/></div>
                </div>
              </div>
            </div>
          </div>
          <div class="masonry-side">
            <div class="hero-card hero-card-small">
              <img src="/media/catalog/-0IhYpOOJNo.webp" alt="Workspace" class="hero-img" />
              <div class="card-content">
                <h4>A Kreatív Munkaterület</h4>
                <p>Rituálék, eszközök, és egy nyugodtabb tér a nagyszerű munkához.</p>
                <div class="meta-small">Március 28, 2026</div>
              </div>
            </div>
            <div class="hero-card hero-card-quote">
              <h3>"{home.quote}"</h3>
              <p class="attribution">— {home.quoteAttribution}</p>
            </div>
          </div>
        </div>
        
        <div class="tech-stack-badge">
          <div class="hand-arrow">
            <span>Beautiful<br/>by default.</span>
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none" stroke="currentColor"><path d="M5 20 Q 20 10 35 25 M 30 25 L 35 25 L 35 20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <ul>
            <li><Icon name="file" size={16}/> Markdown</li>
            <li><Icon name="settings" size={16}/> GitHub</li>
            <li><Icon name="arrow-up" size={16}/> Vercel</li>
            <li><Icon name="home" size={16}/> Your domain</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 2. FEATURED STORIES -->
    <section class="forge-section">
      <div class="section-header">
        <h2>Kiemelt írások</h2>
        <a href="/posts/" class="view-all">Összes írás <Icon name="arrow" size={14}/></a>
      </div>
      <div class="post-grid-4">
        {latest.map((post) => <PostCard post={post} />)}
      </div>
    </section>

    <!-- 3. EXPLORE BY CATEGORY -->
    <section class="forge-section">
      <div class="section-header">
        <h2>Felfedezés kategóriák szerint</h2>
        <a href="/categories/" class="view-all">Témák böngészése <Icon name="arrow" size={14}/></a>
      </div>
      <div class="category-pills">
        {categories.map((cat) => (
          <a href={`/category/${cat.id}/`} class="category-pill">
            <span class="pill-icon"><Icon name={(catIcons[cat.id] || 'file') as any} size={16}/></span>
            {cat.data.title}
          </a>
        ))}
        <a href="/categories/" class="category-pill more">
          More topics <Icon name="arrow" size={14}/>
        </a>
      </div>
    </section>

    <!-- 4. BENTO BOXES -->
    {home.bentoBoxes.length === 3 && (
      <section class="forge-section bento-grid">
        <div class="bento-box box-gallery">
          <div class="bento-visual">
            <img src="/media/catalog/0AwoTNSdwVM.webp" alt="Gallery" class="bento-img"/>
          </div>
          <div class="bento-content">
            <h3>{home.bentoBoxes[0].title}</h3>
            <p>{home.bentoBoxes[0].description}</p>
            <a href={home.bentoBoxes[0].ctaHref} class="btn-bento">{home.bentoBoxes[0].ctaLabel} <Icon name="arrow" size={14}/></a>
          </div>
        </div>
        
        <div class="bento-box box-workspace">
          <div class="bento-content top">
            <h3>{home.bentoBoxes[1].title}</h3>
            <p>{home.bentoBoxes[1].description}</p>
            <ul class="bento-features">
              {home.bentoBoxes[1].features?.map(f => <li><Icon name="check" size={14}/> {f}</li>)}
            </ul>
            <a href={home.bentoBoxes[1].ctaHref} class="btn btn-primary small">{home.bentoBoxes[1].ctaLabel} <Icon name="arrow" size={14}/></a>
          </div>
          <div class="bento-visual bottom">
             <div class="mockup-ui">
               <div class="mockup-header">My Blog</div>
               <div class="mockup-body">
                 <div class="mockup-sidebar"></div>
                 <div class="mockup-content"></div>
               </div>
             </div>
          </div>
        </div>

        <div class="bento-box box-themes">
           <div class="bento-content">
            <h3>{home.bentoBoxes[2].title}</h3>
            <p>{home.bentoBoxes[2].description}</p>
            <a href={home.bentoBoxes[2].ctaHref} class="btn btn-primary small">{home.bentoBoxes[2].ctaLabel} <Icon name="arrow" size={14}/></a>
          </div>
          <div class="bento-visual">
            <div class="theme-cards">
               <img src="/media/catalog/0_Oks_vAXrM.webp" alt="Theme 1" class="tcard t1"/>
               <img src="/media/catalog/0hi3uEJ3yOE.webp" alt="Theme 2" class="tcard t2"/>
            </div>
          </div>
          <div class="hand-arrow-right">
            <span>Flexible.<br/>White-label.<br/>Yours.</span>
          </div>
        </div>
      </section>
    )}

    <!-- 5. STATS -->
    <section class="forge-stats">
      {home.stats.map(s => (
        <div class="stat-item">
          <div class="stat-icon"><Icon name="search" size={24}/></div>
          <div class="stat-text">
            <div class="stat-value">{s.value}</div>
            <div class="stat-label">{s.label}</div>
          </div>
        </div>
      ))}
    </section>

    <!-- 6. NEWSLETTER -->
    <NewsletterSignup />

  </div>
</BaseLayout>

<style>
/* New Landing Page CSS */
.forge-home {
  padding-top: 60px;
  padding-bottom: 80px;
}
.forge-section {
  margin-bottom: 80px;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24px;
  border-bottom: 1px solid var(--line);
  padding-bottom: 16px;
}
.section-header h2 {
  font-size: 24px;
  margin: 0;
}
.section-header .view-all {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 14px;
  font-weight: 500;
  color: var(--muted);
  text-decoration: none;
}
.section-header .view-all:hover {
  color: var(--ink);
}

/* Hero Section */
.forge-hero {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 40px;
  align-items: center;
  margin-bottom: 100px;
}
.forge-hero-content {
  padding-right: 40px;
}
.eyebrow {
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
}
.eyebrow .dot {
  width: 6px;
  height: 6px;
  background: var(--muted);
  border-radius: 50%;
}
.headline {
  font-family: var(--heading-font);
  font-size: 56px;
  line-height: 1.1;
  color: var(--ink);
  margin-bottom: 24px;
  font-weight: 400;
}
.headline strong {
  font-weight: 700;
}
.lede {
  font-size: 18px;
  color: var(--muted);
  line-height: 1.6;
  margin-bottom: 32px;
  max-width: 480px;
}
.actions {
  display: flex;
  gap: 16px;
  align-items: center;
  margin-bottom: 32px;
}
.btn-primary, .btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 24px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 15px;
  text-decoration: none;
  transition: all 0.2s;
}
.btn-primary {
  background: var(--primary);
  color: var(--on-primary);
}
.btn-primary:hover {
  filter: brightness(1.1);
}
.btn-primary.small {
  padding: 8px 16px;
  font-size: 14px;
  border-radius: 6px;
}
.btn-secondary {
  background: var(--surface);
  color: var(--ink);
  border: 1px solid var(--line);
}
.btn-secondary:hover {
  border-color: var(--muted);
}
.assurances {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 24px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink);
}
.assurances li {
  display: flex;
  align-items: center;
  gap: 6px;
}

/* Hero Visuals & Masonry */
.forge-hero-visuals {
  position: relative;
}
.masonry-grid {
  display: grid;
  grid-template-columns: 1fr 0.8fr;
  gap: 16px;
}
.hero-card {
  background: var(--surface);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: var(--shadow);
  border: 1px solid var(--line);
  position: relative;
}
.hero-card .hero-img {
  width: 100%;
  object-fit: cover;
  display: block;
}
.hero-card-large .hero-img {
  height: 240px;
}
.hero-card-small .hero-img {
  height: 120px;
}
.badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 4px;
  letter-spacing: 0.05em;
}
.card-content {
  padding: 20px;
}
.hero-card h3 {
  font-size: 20px;
  margin: 0 0 8px;
  font-family: var(--heading-font);
}
.hero-card h4 {
  font-size: 16px;
  margin: 0 0 6px;
  font-family: var(--heading-font);
}
.hero-card p {
  font-size: 14px;
  color: var(--muted);
  margin: 0 0 16px;
  line-height: 1.5;
}
.meta {
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 12px;
  color: var(--muted);
}
.meta .avatar {
  width: 24px;
  height: 24px;
  border-radius: 50%;
}
.meta .arrow-circle {
  margin-left: auto;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  border: 1px solid var(--line);
  display: grid;
  place-items: center;
  color: var(--ink);
}
.meta-small {
  font-size: 12px;
  color: var(--muted);
}
.masonry-side {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.hero-card-quote {
  padding: 24px;
  background: var(--surface-soft);
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.hero-card-quote h3 {
  font-size: 18px;
  font-style: italic;
  margin-bottom: 12px;
}
.hero-card-quote .attribution {
  font-size: 11px;
  letter-spacing: 0.1em;
  margin: 0;
  text-transform: uppercase;
}

/* Tech Stack Badge */
.tech-stack-badge {
  position: absolute;
  bottom: -30px;
  right: -20px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 16px;
  box-shadow: var(--shadow);
  z-index: 2;
}
.tech-stack-badge ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.tech-stack-badge li {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 13px;
  font-weight: 500;
  color: var(--ink);
}
.hand-arrow {
  position: absolute;
  top: -60px;
  left: -20px;
  color: var(--muted);
  font-family: 'Kalam', cursive, sans-serif;
  font-size: 14px;
  transform: rotate(-10deg);
  text-align: center;
}

/* Post Grid 4 */
.post-grid-4 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

/* Category Pills */
.category-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.category-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
  color: var(--ink);
  text-decoration: none;
  transition: all 0.2s;
}
.category-pill:hover {
  border-color: var(--primary);
  background: var(--surface-soft);
}
.pill-icon {
  color: var(--primary);
  display: flex;
  align-items: center;
}
.category-pill.more {
  border-style: dashed;
  color: var(--muted);
}

/* Bento Grid */
.bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 24px;
}
.bento-box {
  background: var(--surface);
  border-radius: 16px;
  border: 1px solid var(--line);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}
.bento-content {
  padding: 32px;
}
.bento-content h3 {
  font-size: 22px;
  margin: 0 0 12px;
  font-family: var(--heading-font);
}
.bento-content p {
  color: var(--muted);
  font-size: 15px;
  margin: 0 0 24px;
  line-height: 1.5;
}
.btn-bento {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 600;
  color: var(--primary);
  text-decoration: none;
  background: var(--surface);
  padding: 8px 16px;
  border-radius: 20px;
  border: 1px solid var(--line);
}
.btn-bento:hover {
  border-color: var(--primary);
}
.box-gallery {
  position: relative;
  background: #2a3b4c;
  color: #fff;
}
.box-gallery .bento-visual {
  height: 200px;
}
.box-gallery .bento-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.8;
}
.box-gallery .bento-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: linear-gradient(to top, rgba(26,43,59,1) 40%, rgba(26,43,59,0));
}
.box-gallery h3, .box-gallery p {
  color: #fff;
}
.box-gallery .btn-bento {
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: none;
}
.box-workspace .bento-features {
  list-style: none;
  padding: 0;
  margin: 0 0 24px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: 14px;
  color: var(--ink);
}
.box-workspace .bento-features li {
  display: flex;
  align-items: center;
  gap: 8px;
}
.box-workspace .bento-visual.bottom {
  background: var(--surface-soft);
  flex-grow: 1;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}
.mockup-ui {
  background: var(--surface);
  width: 90%;
  height: 140px;
  border-radius: 8px 8px 0 0;
  box-shadow: var(--shadow);
  border: 1px solid var(--line);
  border-bottom: none;
  display: flex;
  flex-direction: column;
}
.mockup-header {
  padding: 8px 12px;
  border-bottom: 1px solid var(--line);
  font-size: 10px;
  font-weight: 600;
}
.mockup-body {
  display: flex;
  flex-grow: 1;
}
.mockup-sidebar {
  width: 30%;
  border-right: 1px solid var(--line);
  background: var(--surface-soft);
}
.box-themes {
  background: var(--surface-soft);
}
.box-themes .bento-visual {
  flex-grow: 1;
  position: relative;
  overflow: hidden;
}
.theme-cards {
  position: absolute;
  width: 100%;
  height: 100%;
}
.tcard {
  position: absolute;
  width: 60%;
  border-radius: 8px;
  box-shadow: var(--shadow);
  border: 1px solid var(--line);
}
.tcard.t1 {
  top: 20px;
  left: 20px;
}
.tcard.t2 {
  top: 60px;
  right: -10px;
}
.hand-arrow-right {
  position: absolute;
  right: 10px;
  top: 50%;
  transform: translateY(-50%) rotate(5deg);
  font-family: 'Kalam', cursive, sans-serif;
  font-size: 14px;
  color: var(--muted);
  text-align: center;
}

/* Stats */
.forge-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
  padding: 40px 0;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
  margin-bottom: 80px;
}
.stat-item {
  display: flex;
  align-items: center;
  gap: 16px;
}
.stat-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  color: var(--muted);
}
.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 4px;
}
.stat-label {
  font-size: 13px;
  color: var(--muted);
}

@media (max-width: 1024px) {
  .forge-hero, .bento-grid {
    grid-template-columns: 1fr;
  }
  .post-grid-4 {
    grid-template-columns: repeat(2, 1fr);
  }
  .forge-stats {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 640px) {
  .post-grid-4, .forge-stats {
    grid-template-columns: 1fr;
  }
  .masonry-grid {
    grid-template-columns: 1fr;
  }
  .tech-stack-badge {
    display: none;
  }
}
</style>
