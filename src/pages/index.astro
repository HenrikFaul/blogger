---
/**
 * Editorial blog homepage, built to the ForgeBlog Studio v2 design reference
 * (handoff/01-editorial-home.json): a serif editorial hero with an abstract
 * illustration, then a grid of the latest posts. Content is the real published
 * collection; the hero copy and brand come from src/config/site.json.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/content/PostCard.astro';
import Icon from '../components/ui/Icon.astro';
import { getCardPosts } from '../lib/content';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config/site.config';

const posts = await getCardPosts();
const home = siteConfig.home;
const latest = posts.slice(0, 3);
const blogPosts = posts.slice(0, 20).map((p) => ({
  headline: p.title,
  url: new URL(`/posts/${p.slug}/`, siteConfig.siteUrl).href,
  datePublished: p.date,
}));

const authors = await getCollection('authors');
const author = authors.find((a) => a.id === siteConfig.content.defaultAuthor);
const authorName = author?.data.name || 'Nóra';
import NewsletterSignup from '../components/content/NewsletterSignup.astro';
const categories = await getCollection('categories');
---
<BaseLayout title={siteConfig.name} description={home.lede} type="blog" blogPosts={blogPosts}>
  <div class="container">

    <section class="editorial-hero" aria-labelledby="editorial-heading">
      <div class="editorial-hero-copy">
        <p class="eyebrow eyebrow-mono"><span class="dot" aria-hidden="true"/>{home.eyebrow}</p>
        <h1 id="editorial-heading">{home.headline}<br/><em>{home.headlineAccent}</em></h1>
        <p class="editorial-lede">{home.lede}</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href={home.primaryCtaHref}>{home.primaryCtaLabel}<Icon name="arrow" size={16}/></a>
          <a class="text-link" href={home.secondaryCtaHref}>{home.secondaryCtaLabel}</a>
        </div>
        <div class="editorial-author">
          <img class="avatar" src={author?.data.avatar || '/media/nora.svg'} alt="" width="36" height="36" loading="lazy"/>
          <span><strong>{authorName}</strong> személyes folyóirata</span>
        </div>
      </div>
      <figure class="editorial-hero-media" aria-hidden="true">
        <img src="/media/catalog/6RqSDGaNJ5c.webp" alt="Minimalist workspace" width="732" height="480" fetchpriority="high" decoding="async" style="border-radius: var(--corner); box-shadow: var(--shadow); object-fit: cover; height: 100%; width: 100%; aspect-ratio: 4/3;"/>
      </figure>
    </section>

    {latest.length > 0 && (
      <section class="editorial-posts" aria-label="Legfrissebb írások" style="margin-bottom: 80px;">
        <div class="post-grid">{latest.map((post) => <PostCard post={post} />)}</div>
      </section>
    )}

    {categories.length > 0 && (
      <section class="home-categories" aria-label="Témák" style="margin-bottom: 80px;">
        <div style="margin-bottom: 32px; text-align: center;">
          <h2 style="font-size: 32px; letter-spacing: -0.015em; line-height: 1.25;">Felfedezés témák szerint</h2>
          <p style="color: var(--muted); font-size: 17px; margin-top: 8px;">Válogass a legnépszerűbb kategóriákból, és találd meg, ami érdekel.</p>
        </div>
        <div class="category-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px;">
          {categories.slice(0, 4).map((category) => (
            <a href={`/category/${category.id}/`} class="card-panel" style="display: flex; flex-direction: column; align-items: center; padding: 24px; text-align: center; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; transition: transform 0.2s, border-color 0.2s;">
              <div style="width: 48px; height: 48px; border-radius: 50%; background: color-mix(in srgb, var(--primary) 10%, var(--surface)); color: var(--primary); display: grid; place-items: center; margin-bottom: 16px;">
                <Icon name="tag" size={24} />
              </div>
              <h3 style="font-size: 18px; margin: 0;">{category.data.title}</h3>
              <p style="color: var(--muted); font-size: 14px; margin-top: 6px; margin-bottom: 0;">{category.data.description || 'Felfedezés'}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="home-resources" aria-label="Tanulási Központ" style="margin-bottom: 80px;">
      <div style="margin-bottom: 32px; text-align: center;">
        <h2 style="font-size: 32px; letter-spacing: -0.015em; line-height: 1.25;">Tanulási Központ / Resources</h2>
        <p style="color: var(--muted); font-size: 17px; margin-top: 8px;">Hasznos útmutatók és eszközök a fejlődéshez.</p>
      </div>
      <div class="category-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">
        <a href="/about" class="card-panel" style="display: flex; flex-direction: column; padding: 24px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; transition: transform 0.2s, border-color 0.2s;">
          <div style="width: 40px; height: 40px; border-radius: 8px; background: color-mix(in srgb, var(--primary) 10%, var(--surface)); color: var(--primary); display: grid; place-items: center; margin-bottom: 16px;">
            <Icon name="book" size={20} />
          </div>
          <h3 style="font-size: 20px; margin: 0 0 8px 0;">Hogyan indulj el?</h3>
          <p style="color: var(--muted); font-size: 15px; margin: 0;">Átfogó útmutató kezdőknek a hatékony blogoláshoz és íráshoz.</p>
        </a>
        <a href="/archive" class="card-panel" style="display: flex; flex-direction: column; padding: 24px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; transition: transform 0.2s, border-color 0.2s;">
          <div style="width: 40px; height: 40px; border-radius: 8px; background: color-mix(in srgb, var(--primary) 10%, var(--surface)); color: var(--primary); display: grid; place-items: center; margin-bottom: 16px;">
            <Icon name="tag" size={20} />
          </div>
          <h3 style="font-size: 20px; margin: 0 0 8px 0;">Eszköztár & Sablonok</h3>
          <p style="color: var(--muted); font-size: 15px; margin: 0;">Válogatott eszközök, melyeket nap mint nap használunk az alkotáshoz.</p>
        </a>
      </div>
    </section>

    <section class="social-proof" style="margin-bottom: 80px; text-align: center; padding: 60px 24px; background: color-mix(in srgb, var(--primary) 5%, var(--surface)); border-radius: 16px;">
      <Icon name="quote" size={32} style="color: var(--primary); margin-bottom: 24px; opacity: 0.5;" />
      <blockquote style="font-size: 24px; font-style: italic; max-width: 700px; margin: 0 auto 24px; line-height: 1.4; color: var(--ink);">
        "Egy tér, ahol a gondolatoknak van idejük megérni. Nem sietünk sehova, csak hagyjuk, hogy a szavak a helyükre kerüljenek."
      </blockquote>
      <div style="display: flex; align-items: center; justify-content: center; gap: 12px;">
        <img class="avatar" src={author?.data.avatar || '/media/nora.svg'} alt="" width="48" height="48" style="border-radius: 50%; object-fit: cover;" loading="lazy"/>
        <div style="text-align: left;">
          <strong style="display: block; font-size: 16px;">{authorName}</strong>
          <span style="color: var(--muted); font-size: 14px;">Alapító, Író</span>
        </div>
      </div>
    </section>

    <NewsletterSignup />

  </div>
</BaseLayout>

<style>
  .category-grid a.card-panel:hover {
    transform: translateY(-4px);
    border-color: var(--primary);
  }
</style>


