---
import BaseLayout from '../layouts/BaseLayout.astro';import Icon from '../components/ui/Icon.astro';import {getCollection} from 'astro:content';import {getPublishedPosts} from '../lib/content';
const series=await getCollection('series');const posts=await getPublishedPosts();
---
<BaseLayout title="Történetek sorozatban" description="Egy téma, több nézőpont. A ForgeBlog cikksorozatai."><div class="container"><section class="page-heading"><div><p class="eyebrow">EGY TÉMA, TÖBB NÉZŐPONT</p><h1>Történetek sorozatban.</h1><p>Néha egy cikk csak a kezdet. Itt tovább követheted a gondolatot.</p></div></section><div class="taxonomy-grid">{series.map(s=><article class="taxonomy-card">{s.data.image&&<img src={s.data.image.src} alt={s.data.image.alt} width={s.data.image.width||600} height={s.data.image.height||400} loading="lazy"/>}<div class="taxonomy-card-content"><p class="eyebrow" style="margin-bottom:10px">{posts.filter(p=>p.data.series===s.id).length} RÉSZ</p><h2><a href={`/series/${s.id}/`}>{s.data.title}</a></h2><p>{s.data.description}</p><a class="text-link" href={`/series/${s.id}/`}>A sorozat olvasása<Icon name="arrow" size={15}/></a></div></article>)}</div></div></BaseLayout>
