---
import BaseLayout from '../layouts/BaseLayout.astro';import Icon from '../components/ui/Icon.astro';import {getCollection} from 'astro:content';import {getCardPosts} from '../lib/content';
const posts=await getCardPosts();const categories=(await getCollection('categories')).map(c=>({...c,count:posts.filter(p=>p.categoryIds.includes(c.id)).length})).filter(c=>c.count>0);
---
<BaseLayout title="Találd meg a témád" description="Utazás, életmód, technológia, alkotás és gasztronómia. Fedezd fel a magazin témáit."><div class="container"><section class="page-heading"><div><p class="eyebrow">KÖVESD A KÍVÁNCSISÁGOD</p><h1>Találd meg a témád.</h1><p>Egy apró kitérőből is indulhat nagy felfedezés.</p></div><a class="text-link" href="/series/">Cikksorozatok<Icon name="arrow" size={15}/></a></section><div class="taxonomy-grid">{categories.map(cat=><article class="taxonomy-card">{cat.data.image&&<a href={`/category/${cat.id}/`} aria-label={cat.data.title}><img src={cat.data.image} alt="" width="500" height="330" loading="lazy"/></a>}<div class="taxonomy-card-content"><p class="eyebrow" style="margin-bottom:10px">{cat.count} TÖRTÉNET</p><h2><a href={`/category/${cat.id}/`}>{cat.data.title}</a></h2><p>{cat.data.description}</p><a class="text-link" href={`/category/${cat.id}/`}>Felfedezem<Icon name="arrow" size={14}/></a></div></article>)}</div></div></BaseLayout>
