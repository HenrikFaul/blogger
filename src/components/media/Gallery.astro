---
import Icon from '../ui/Icon.astro';
import {safeImageUrl} from '../../lib/safety';
interface GalleryImage {src:string;alt:string;caption?:string;credit?:string;decorative?:boolean;width?:number;height?:number;mediaType?:'image'|'video'|'embed';embedUrl?:string;comparisonAfterSrc?:string;}
interface Props {images:GalleryImage[];layout?:string;columns?:number;gap?:'none'|'small'|'medium'|'large';captions?:'none'|'hover'|'always'|'below';clickBehavior?:'lightbox'|'none'|'link';aspectRatio?:'auto'|'square'|'landscape'|'portrait';}
const {images:input,layout:requested='editorial-grid',columns:inputColumns=3,gap='medium',captions='below',clickBehavior='lightbox',aspectRatio='auto'}=Astro.props;
const layouts=['editorial-grid','masonry','justified','carousel','stacked','filmstrip','comparison','full-bleed','lightbox','mixed'];const layout=layouts.includes(requested)?requested:'editorial-grid';
const images=(input||[]).filter(image=>safeImageUrl(image.src)).slice(0,50);const columns=Math.min(5,Math.max(1,Math.floor(inputColumns)));
const id=`gallery-${crypto.randomUUID().slice(0,8)}`;const gapSize={none:0,small:6,medium:12,large:22}[gap]||0;
const first=images[0];const LightboxLink=clickBehavior==='none'?'div':'a';
---
{images.length>0&&<section id={id} class="gallery" data-gallery data-layout={layout} data-captions={captions} data-aspect-ratio={aspectRatio} style={`--gallery-columns:${columns};--gallery-gap:${gapSize}px`} aria-label="Képgaléria">
 {layout==='comparison'&&images.length>=2?<><div class="gallery-comparison" data-comparison><img src={first.src} alt={first.decorative?'':first.alt} width={first.width||600} height={first.height||400} loading="lazy"/><img class="comparison-after" src={images[1].src} alt={images[1].decorative?'':images[1].alt} width={images[1].width||600} height={images[1].height||400} loading="lazy"/><span class="comparison-line"></span><span class="comparison-label">{first.caption||'Első kép'}</span><span class="comparison-label after">{images[1].caption||'Második kép'}</span></div><label class="comparison-range" for={`${id}-range`}>Képek összehasonlítása<input id={`${id}-range`} type="range" min="0" max="100" value="50" data-comparison-range aria-label="Az összehasonlítás választóvonalának helyzete"/><span data-comparison-value>50%</span></label><p class="form-hint"><a href={first.src}>Első kép külön</a> · <a href={images[1].src}>Második kép külön</a></p></>:<>
 {layout==='filmstrip'&&<figure style="margin-bottom:12px"><a href={first.src} class="gallery-image-btn" style="aspect-ratio:1.7" data-gallery-main data-gallery-open={clickBehavior==='lightbox'?true:undefined} data-gallery-index="0" aria-label={`Kép megnyitása: ${first.alt||first.caption||'1. kép'}`}><img src={first.src} alt={first.decorative?'':first.alt} width={first.width||600} height={first.height||400} loading="lazy" data-film-image/></a><figcaption data-film-caption>{first.caption}</figcaption></figure>}
 <div class="gallery-items" data-gallery-items>{images.map((image,index)=><figure data-gallery-item data-src={image.src} data-alt={image.decorative?'':image.alt} data-caption={image.caption||''} data-credit={image.credit||''} style={`--image-ratio:${(image.width||600)/(image.height||400)}`}>
 {layout==='mixed'&&image.mediaType==='video'?<video class="gallery-video" controls preload="none" aria-label={image.alt}><source src={image.src}/><a href={image.src}>Videó megnyitása</a></video>:<LightboxLink class="gallery-image-btn" href={clickBehavior==='none'?undefined:image.src} data-gallery-open={clickBehavior==='lightbox'&&layout!=='filmstrip'?true:undefined} data-film-select={layout==='filmstrip'?true:undefined} data-gallery-index={index} aria-label={clickBehavior==='none'?undefined:`${layout==='filmstrip'?'Kép kiválasztása':'Kép megnyitása'}: ${image.alt||image.caption||`${index+1}. kép`}`}><img src={image.src} alt={image.decorative?'':image.alt} width={image.width||600} height={image.height||400} loading="lazy" decoding="async"/></LightboxLink>}
 {image.caption&&<figcaption>{image.caption}{image.credit&&<span> · {image.credit}</span>}</figcaption>}
 </figure>)}</div>
 {(layout==='carousel'||layout==='filmstrip')&&<div class="gallery-controls js-only"><span>{images.length} kép · a képsor görgethető</span><div class="inline-stack" style="gap:5px"><button type="button" class="btn btn-small" data-gallery-scroll="-1" aria-label="Képsor görgetése balra"><Icon name="arrow-left" size={15}/></button><button type="button" class="btn btn-small" data-gallery-scroll="1" aria-label="Képsor görgetése jobbra"><Icon name="arrow" size={15}/></button></div></div>}
 </>}
 {clickBehavior==='lightbox'&&layout!=='comparison'&&<dialog class="lightbox" data-lightbox aria-label="Képgaléria nagyított nézete"><div class="lightbox-top"><span data-lightbox-counter style="font-size:12px;margin-right:8px">1 / {images.length}</span><button class="icon-btn" type="button" data-lightbox-zoom aria-label="Kép nagyítása" aria-pressed="false"><Icon name="search"/></button><button class="icon-btn" type="button" data-lightbox-close aria-label="Nagyított nézet bezárása" autofocus><Icon name="close"/></button></div><button type="button" class="icon-btn lightbox-prev" data-lightbox-prev aria-label="Előző kép"><Icon name="arrow-left"/></button><div class="lightbox-image-wrap"><img data-lightbox-image src={first.src} alt={first.decorative?'':first.alt} width={first.width||600} height={first.height||400}/></div><button type="button" class="icon-btn lightbox-next" data-lightbox-next aria-label="Következő kép"><Icon name="arrow"/></button><div class="lightbox-caption" aria-live="polite"><strong data-lightbox-caption></strong><span data-lightbox-credit></span></div></dialog>}
</section>}
