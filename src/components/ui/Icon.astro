---
import {iconPaths,type IconName} from '../../lib/icons';
interface Props {name:IconName;size?:number;class?:string;}
const {name,size=20,class:className=''}=Astro.props;
---
<svg class:list={['icon',className]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={iconPaths[name]}/></svg>
