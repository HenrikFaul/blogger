---
/**
 * Hero cluster from the design plan: one large featured story plus stacked feature cards,
 * a quote tile and an integration rail. Every tile links to a real published post; when a
 * tile has no real post behind it the component renders the quote tile instead of a
 * fabricated card. No invented numbers, no dead links.
 */
import Icon from '../ui/Icon.astro';
import {formatDate} from '../../lib/content';
import type {CardPost} from '../../lib/content';
import {siteConfig} from '../../config/site.config';
interface Props {posts:CardPost[];}
const {posts}=Astro.props;
const [lead,...rest]=posts;
const stack=rest.slice(0,2);
const third=rest[2];
const railtems=[
 {icon:'code' as const,label:'Markdown'},
 {icon:'github' as const,label:'GitHub'},
 {icon:'arrow-up' as const,label:'Vercel'},
 {icon:'link' as const,label:'Saját domain'},
];
---
<div class="hero-mosaic">
 <div class="mosaic-main">
  {lead?(
   <article class="mosaic-lead">
    <a class="mosaic-lead-media" href={`/posts/${lead.slug}/`} aria-label={lead.title}>
     {lead.image?<img src={lead.image.src} alt={lead.image.alt} width={lead.image.width||1100} height={lead.image.height||720} fetchpriority="high" decoding="async"/>:<span class="mosaic-placeholder" aria-hidden="true"/>}
     <span class="pill mosaic-flag">KIEMELT</span>
    </a>
    <div class="mosaic-lead-copy">
     <h3><a href={`/posts/${lead.slug}/`}>{lead.title}</a></h3>
     <p>{lead.excerpt}</p>
     <div class="byline"><img class="avatar" src={lead.authorAvatar||'/media/nora.svg'} alt="" width="30" height="30"/><a href={`/authors/${lead.authorId}/`}><strong>{lead.author}</strong></a><span aria-hidden="true">·</span><time datetime={lead.date}>{formatDate(lead.date)}</time></div>
    </div>
   </article>
  ):<span class="mosaic-placeholder mosaic-placeholder-lead" aria-hidden="true"/>}
 </div>
 <div class="mosaic-side">
  {stack.map(post=>(
   <article class="mosaic-tile">
    <a class="mosaic-tile-media" href={`/posts/${post.slug}/`} aria-label={post.title}>
     {post.image?<img src={post.image.src} alt={post.image.alt} width={post.image.width||520} height={post.image.height||340} loading="lazy" decoding="async"/>:<span class="mosaic-placeholder" aria-hidden="true"/>}
    </a>
    <div class="mosaic-tile-copy">
     <h3><a href={`/posts/${post.slug}/`}>{post.title}</a></h3>
     <p class="mosaic-tile-meta"><time datetime={post.date}>{formatDate(post.date)}</time></p>
    </div>
   </article>
  ))}
  <div class="mosaic-quote">
   {third?.image&&<img src={third.image.src} alt="" width="240" height="240" loading="lazy" decoding="async"/>}
   <blockquote>{siteConfig.home.quote||'„Egy egyszerű blog is mindent megváltoztathat.”'}</blockquote>
   <p class="mosaic-quote-source">{siteConfig.home.quoteAttribution||siteConfig.name.toLocaleUpperCase('hu')}</p>
  </div>
 </div>
 <aside class="mosaic-rail" aria-label="A ForgeBlog eszközei">
  {railtems.map(item=><span class="rail-item"><Icon name={item.icon} size={16}/>{item.label}</span>)}
 </aside>
</div>
