---
/**
 * Metric row from the design plan. Values come from siteConfig.home.stats, so an instance
 * can replace or remove them; nothing is hardcoded inside the component.
 * When a matching icon is unavailable the row falls back to an existing icon instead of
 * rendering a broken glyph.
 */
import Icon from '../ui/Icon.astro';
import {iconPaths,type IconName} from '../../lib/icons';
import {siteConfig} from '../../config/site.config';
const stats=siteConfig.home.stats;
const preferred=['sparkles','check','bookmark','palette'];
const resolve=(index:number):IconName=>{
 const name=preferred[index%preferred.length] as IconName;
 return name in iconPaths?name:'sparkles';
};
---
{stats.length>0&&(
 <section class="stat-row" aria-label="A ForgeBlog számokban">
  {stats.map((stat,index)=>(
   <div class="stat-item">
    <Icon name={resolve(index)} size={22}/>
    <p class="stat-value">{stat.value}</p>
    <p class="stat-label">{stat.label}</p>
   </div>
  ))}
 </section>
)}