---
/**
 * Closing call-to-action band from the design plan.
 *
 * IMPORTANT: newsletterEnabled is `literal false` in the instance schema, so this band must
 * never render a subscribe form that cannot work. The design's intent is preserved with a
 * real, working destination instead: the RSS feed, which needs no account or backend.
 * If a future instance enables a real newsletter backend this becomes the single place to swap.
 */
import Icon from '../ui/Icon.astro';
import {siteConfig} from '../../config/site.config';
const stats=siteConfig.home.stats;
---
<section class="cta-band" aria-labelledby="cta-band-heading">
 <div class="cta-band-inner">
  <div class="cta-band-copy">
   <h2 id="cta-band-heading">Építsünk egy barátságosabb internetet.</h2>
   <p>Új történetek, írási tippek és alkotói gondolatok az olvasódban. Fiók, e-mail-cím és feliratkozás nélkül.</p>
  </div>
  <div class="cta-band-action">
   <a class="btn btn-primary" href="/rss.xml"><Icon name="rss" size={16}/>RSS-csatorna megnyitása</a>
   <p class="cta-band-note">Nincs spam. Csak jó történetek.</p>
  </div>
 </div>
 {stats.length>0&&<div class="cta-band-shape" aria-hidden="true"/>}
</section>
