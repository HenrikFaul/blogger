{
  "name": "project4-blogspot",
  "type": "module",
  "version": "0.3.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:unit": "node --import ./scripts/test/register.mjs --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "verify": "npm run check && npm run test:unit && npm run test:contrast && npm run build",
    "check": "astro sync && astro check",
    "qa:prepare": "node scripts/qa/templates.mjs && node scripts/qa/bundle.mjs",
    "qa:preview": "node --import ./scripts/qa/register.mjs ./scripts/qa/server.mjs",
    "update:review": "node scripts/update-sync.mjs",
    "test:contrast": "node scripts/check-theme-contrast.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/extension-character-count": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "private": true
}
