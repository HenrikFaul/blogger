# Helyi íráshoz és olvasáshoz minden titok üresen hagyható.
# Éles Vercel-buildhez add meg a SAJÁT HTTPS-origint (útvonal nélkül).
PUBLIC_SITE_URL=

# Opcionális szerveroldali GitHub App kapcsolat. Részletek: docs/GITHUB_SETUP.md.
# Titkokat NE PUBLIC_ változóban és NE a src/config/site.json fájlban tárolj.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REPOSITORY=
# Legalább 32 véletlenszerű karakter. Új kulcs: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# app: a telepített GitHub App repository-jogosultságait használja.
# oauth: hagyományos OAuth App, szélesebb repo scope; csak tudatosan válaszd.
GITHUB_AUTH_MODE=app
# Opcionális, vesszővel elválasztott GitHub login allowlist. A repo write jog mindig szükséges.
GITHUB_ALLOWED_LOGINS=
